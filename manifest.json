{
  "manifest_version": 3,
  "name": "JournalLens — Journal Rank, Impact & Author Order",
  "short_name": "JournalLens",
  "version": "2.1.0",
  "description": "Scopus quartile & CiteScore, Web of Science index, Impact Factor and CORE conference rank from official sources, with author order and charts on Google Scholar. By Dr. Mohammed Tawfik.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "JournalLens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.scopus.com/*",
    "https://mjl.clarivate.com/*",
    "https://api.crossref.org/*",
    "https://portal.core.edu.au/*"
  ],
